    "/api/v1/describe/{path}": {
      "get": {
        "summary": "Describe",
        "description": "Describe a file of data from its headers, without reading its data:\neach of its arrays, and what a dataset of it refuses or needs given;\nvelocity is the convention of velocities that its headers leave\nambiguous (see ArrayInfo).",
        "operationId": "describe_api_v1_describe__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          },
          {
            "name": "velocity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "radio",
                    "optical"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Velocity"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ArrayInfo"
                  },
                  "title": "Response Describe Api V1 Describe  Path  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/views/channel/{path}": {
      "get": {
        "summary": "View Channel",
        "description": "Return a channel of a cube (an array of a file of data, in the\norientation of the model) as a frame of one array (ny, nx), with the\nnumber of channels of the cube, the coordinate of the channel along\nthe spectral axis and its unit (null if unknown; see SpectrumView),\nand the range of the values of the cube for colours.",
        "operationId": "view_channel_api_v1_views_channel__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          },
          {
            "name": "hdu",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Hdu"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Channel"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/views/spectrum/{path}": {
      "get": {
        "summary": "View Spectrum",
        "description": "Return the spectrum of a pixel (x, y) of a cube.",
        "operationId": "view_spectrum_api_v1_views_spectrum__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          },
          {
            "name": "hdu",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Hdu"
            }
          },
          {
            "name": "x",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "X"
            }
          },
          {
            "name": "y",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Y"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
