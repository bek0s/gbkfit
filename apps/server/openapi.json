{
  "openapi": "3.1.0",
  "info": {
    "title": "GBKFIT server",
    "version": "1"
  },
  "paths": {
    "/api/v1/projects": {
      "get": {
        "summary": "Projects",
        "description": "List the paths of the projects of the workspace.",
        "operationId": "projects_api_v1_projects_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "title": "Response Projects Api V1 Projects Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{path}": {
      "get": {
        "summary": "Project",
        "description": "Return a project: its pieces, setups and runs.",
        "operationId": "project_api_v1_projects__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files/{path}": {
      "get": {
        "summary": "Read File",
        "description": "Return the text of a file (e.g. a piece or a setup).",
        "operationId": "read_file_api_v1_files__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Write File",
        "description": "Write the text of a file, and its folders.",
        "operationId": "write_file_api_v1_files__path__put",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string",
                "title": "Text"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{path}": {
      "get": {
        "summary": "Run",
        "description": "Return a run: its manifest.",
        "operationId": "run_api_v1_runs__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/arrays/{path}": {
      "get": {
        "summary": "Array",
        "description": "Return the data of a FITS file, or one plane of them (along their\nfirst axis), as a frame of one array (float32).",
        "operationId": "array_api_v1_arrays__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          },
          {
            "name": "plane",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Plane"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "summary": "Jobs",
        "description": "List the jobs, oldest first.",
        "operationId": "jobs_api_v1_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobInfo"
                  },
                  "type": "array",
                  "title": "Response Jobs Api V1 Jobs Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit Job",
        "description": "Queue a job, which starts when there is room.",
        "operationId": "submit_job_api_v1_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id_}": {
      "get": {
        "summary": "Job",
        "description": "Return a job.",
        "operationId": "job_api_v1_jobs__id___get",
        "parameters": [
          {
            "name": "id_",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id "
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id_}/stop": {
      "post": {
        "summary": "Stop Job",
        "description": "Stop a job: cancel it if queued, or interrupt it if running, as\nCtrl-C does (e.g. a fit ends with its best so far).",
        "operationId": "stop_job_api_v1_jobs__id___stop_post",
        "parameters": [
          {
            "name": "id_",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id "
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "summary": "Events",
        "description": "Follow the events of the server: 'job' (a job whose state changed),\n'run' (the run of a job, when its manifest changed) and 'progress'\n(a report of the progress of a fit).",
        "operationId": "events_api_v1_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "summary": "Open Session",
        "description": "Open a live session of a configuration: set it up once, to evaluate\nit at the values of its free parameters (see evaluate).",
        "operationId": "open_session_api_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id_}": {
      "get": {
        "summary": "Session",
        "description": "Return a live session.",
        "operationId": "session_api_v1_sessions__id___get",
        "parameters": [
          {
            "name": "id_",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id "
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Close Session",
        "description": "Close a live session.",
        "operationId": "close_session_api_v1_sessions__id___delete",
        "parameters": [
          {
            "name": "id_",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id "
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Info",
        "description": "Return the name and version of the server, and its API.",
        "operationId": "info__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "task": {
            "type": "string",
            "title": "Task"
          },
          "options": {
            "additionalProperties": true,
            "type": "object",
            "title": "Options"
          },
          "created": {
            "type": "string",
            "title": "Created"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "complete",
              "failed",
              "stopped",
              "cancelled"
            ],
            "title": "State"
          },
          "run": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run"
          },
          "started": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started"
          },
          "ended": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended"
          },
          "status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "output": {
            "type": "string",
            "title": "Output"
          }
        },
        "type": "object",
        "required": [
          "id",
          "task",
          "options",
          "created",
          "state",
          "run",
          "started",
          "ended",
          "status",
          "output"
        ],
        "title": "JobInfo",
        "description": "A job: its id, task and options, its state, its run, when it was\ncreated, started and ended, the exit status of its process, and the\nend of its log."
      },
      "JobRequest": {
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "eval",
              "fit",
              "resume"
            ],
            "title": "Task"
          },
          "options": {
            "additionalProperties": true,
            "type": "object",
            "title": "Options",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "task"
        ],
        "title": "JobRequest",
        "description": "A job to run: its task, and the options of the task (see\ngbkfit.tasks), with their paths relative to the workspace. eval and\nfit need a configuration ('config'), and write their run in the runs\nof its setup, unless they give its folder ('output_dir'); resume\nneeds the folder of the run of the fit ('output_dir')."
      },
      "ObservationInfo": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "label",
          "items"
        ],
        "title": "ObservationInfo",
        "description": "An observation of a session: its label, and its data items."
      },
      "ProjectInfo": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "pieces": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Pieces"
          },
          "runs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Runs"
          }
        },
        "type": "object",
        "required": [
          "path",
          "pieces",
          "runs"
        ],
        "title": "ProjectInfo",
        "description": "A project: its path, the names of its pieces and setups by folder\n(e.g. 'galaxies'), and the paths of its runs."
      },
      "RunInfo": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "task": {
            "type": "string",
            "title": "Task"
          },
          "options": {
            "additionalProperties": true,
            "type": "object",
            "title": "Options"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "gbkfit_version": {
            "type": "string",
            "title": "Gbkfit Version"
          },
          "created": {
            "type": "string",
            "title": "Created"
          },
          "updated": {
            "type": "string",
            "title": "Updated"
          },
          "products": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Products"
          }
        },
        "type": "object",
        "required": [
          "path",
          "task",
          "options",
          "status",
          "gbkfit_version",
          "created",
          "updated",
          "products"
        ],
        "title": "RunInfo",
        "description": "A run: its manifest (see gbkfit.outputs)."
      },
      "ServerInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "api": {
            "type": "string",
            "title": "Api"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "api"
        ],
        "title": "ServerInfo",
        "description": "The server: its name and version, and the path of its API."
      },
      "SessionInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "config": {
            "type": "string",
            "title": "Config"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ObservationInfo"
            },
            "type": "array",
            "title": "Observations"
          },
          "free": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object",
            "title": "Free"
          }
        },
        "type": "object",
        "required": [
          "id",
          "config",
          "observations",
          "free"
        ],
        "title": "SessionInfo",
        "description": "A live session: its id, its configuration, its observations, and its\nfree parameters (by element name), with their properties (e.g. their\nvalues, min and max)."
      },
      "SessionRequest": {
        "properties": {
          "config": {
            "type": "string",
            "title": "Config"
          }
        },
        "type": "object",
        "required": [
          "config"
        ],
        "title": "SessionRequest",
        "description": "A live session to open: its configuration (its path)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
