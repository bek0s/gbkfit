              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/views/moments/{path}": {
      "get": {
        "summary": "View Moments",
        "description": "Return the quick moment maps of a cube (NaN where they are not\ndefined) as a frame of five arrays (ny, nx): its flux, velocity,\ndispersion, skewness and kurtosis (named so), of the voxels of the\nmask of its signal grown from seeds of signal-to-noise ratio snr (0:\nof all of them; see Views.moments).",
        "operationId": "view_moments_api_v1_views_moments__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          },
          {
            "name": "hdu",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Hdu"
            }
          },
          {
            "name": "snr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 5,
              "title": "Snr"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
